# Copy to .env for docker compose. Every value is a local-only placeholder.
POSTGRES_USER=pricewatch
POSTGRES_PASSWORD=change-me
RABBITMQ_USER=pricewatch
RABBITMQ_PASSWORD=change-me

# fake = deterministic demo catalog (default, no network); live = real shops via egypt-price-scraper
SCRAPER_MODE=fake
# Seed three demo watches with 30 days of synthetic history into an empty database
DEMO_DATA=false
# Re-check each active watch after this many seconds (default 6 h)
CHECK_INTERVAL_SECONDS=21600
CHECKER_CONCURRENCY=4

# Optional tracing: docker compose --profile obs up, then
# OTEL_EXPORTER_OTLP_ENDPOINT=http://aspire-dashboard:18890
OTEL_EXPORTER_OTLP_ENDPOINT=

# Services read these directly when run outside compose (npm run start -w @price-watch/<app>)
# DATABASE_URL=postgres://pricewatch:change-me@localhost:5432/pricewatch
# RABBITMQ_URL=amqp://pricewatch:change-me@localhost:5672
# API_URL=http://localhost:3000
# SCRAPER_GRPC_URL=localhost:50051
